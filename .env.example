# Leave DATABASE_URL unset to build it from the POSTGRES_* values below
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=llama3.2-vision
RAG_K=4
PROMPT_SEED_PATH=prompts.seed.json
HISTORY_MAX_CHARS=4000
HISTORY_MAX_MESSAGES=30
MEMORY_UPDATE_EVERY=6

# Hatchet (the token is generated automatically by scripts/start-app.sh in Docker)
HATCHET_CLIENT_TOKEN=
HATCHET_ADMIN_EMAIL=admin@example.com
HATCHET_ADMIN_PASSWORD=change-me

# Postgres (pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
